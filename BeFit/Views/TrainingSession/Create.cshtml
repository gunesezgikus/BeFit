@model BeFit.Models.TrainingSession

@{
    ViewData["Title"] = "Oluştur / Create";
}

<h1>Oluştur <span class="text-muted fw-light">/ Create</span></h1>

<h4>Antrenman Oturumu <span class="text-muted fw-light">/ Training Session</span></h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Antrenman oturumunun adı" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartTime" class="control-label"></label>
                <input asp-for="StartTime" class="form-control" placeholder="Oturumun başlangıç tarihi ve saati" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EndTime" class="control-label"></label>
                <input asp-for="EndTime" class="form-control" placeholder="Oturumun bitiş tarihi ve saati" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Oluştur / Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Listeye Dön / Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
