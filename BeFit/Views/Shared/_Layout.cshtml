<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BeFit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BeFit.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BeFit</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark text-center" asp-area="" asp-controller="Home" asp-action="Index" style="line-height: 1.1;">
                                Ana Sayfa <br /> <small class="text-muted" style="font-size: 0.7em;">Home</small>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark text-center" asp-controller="TrainingSession" asp-action="Index" style="line-height: 1.1;">
                                Antrenmanlar <br /> <small class="text-muted" style="font-size: 0.7em;">Trainings</small>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark text-center" asp-controller="ExerciseType" asp-action="Index" style="line-height: 1.1;">
                                Egzersiz Türleri <br /> <small class="text-muted" style="font-size: 0.7em;">Exercise Types</small>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark text-center" asp-controller="Exercise" asp-action="Index" style="line-height: 1.1;">
                                Egzersizler <br /> <small class="text-muted" style="font-size: 0.7em;">Exercises</small>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark text-center" asp-controller="Stats" asp-action="Index" style="line-height: 1.1;">
                                İstatistikler <br /> <small class="text-muted" style="font-size: 0.7em;">Stats</small>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark text-center" asp-area="" asp-controller="Home" asp-action="Privacy" style="line-height: 1.1;">
                                Gizlilik <br /> <small class="text-muted" style="font-size: 0.7em;">Privacy</small>
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BeFit - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
