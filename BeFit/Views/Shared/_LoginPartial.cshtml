@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a  class="nav-link text-dark text-center" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage" style="line-height: 1.1;">
            Merhaba @User.Identity?.Name! <br /> <small class="text-muted" style="font-size: 0.7em;">Hello @User.Identity?.Name!</small>
        </a>
    </li>
    <li class="nav-item">
        <form  class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button  type="submit" class="nav-link btn btn-link text-dark text-center" style="line-height: 1.1;">
                Çıkış Yap <br /> <small class="text-muted" style="font-size: 0.7em;">Logout</small>
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark text-center" asp-area="Identity" asp-page="/Account/Register" style="line-height: 1.1;">
            Kayıt Ol <br /> <small class="text-muted" style="font-size: 0.7em;">Register</small>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark text-center" asp-area="Identity" asp-page="/Account/Login" style="line-height: 1.1;">
            Giriş Yap <br /> <small class="text-muted" style="font-size: 0.7em;">Login</small>
        </a>
    </li>
}
</ul>
