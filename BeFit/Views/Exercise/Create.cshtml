@model BeFit.Models.Exercise

@{
    ViewData["Title"] = "Oluştur / Create";
}

<h1>Oluştur <span class="text-muted fw-light">/ Create</span></h1>

<h4>Egzersiz <span class="text-muted fw-light">/ Exercise</span></h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TrainingSessionId" class="control-label"></label>
                <select asp-for="TrainingSessionId" class ="form-control" asp-items="ViewBag.TrainingSessionId"></select>
            </div>
            <div class="form-group">
                <label asp-for="ExerciseTypeId" class="control-label"></label>
                <select asp-for="ExerciseTypeId" class ="form-control" asp-items="ViewBag.ExerciseTypeId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Load" class="control-label"></label>
                <input asp-for="Load" class="form-control" placeholder="Egzersiz için kullanılan ağırlık" />
                <span asp-validation-for="Load" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Sets" class="control-label"></label>
                <input asp-for="Sets" class="form-control" placeholder="Yapılan set sayısı" />
                <span asp-validation-for="Sets" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Repetitions" class="control-label"></label>
                <input asp-for="Repetitions" class="form-control" placeholder="Set başına tekrar sayısı" />
                <span asp-validation-for="Repetitions" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Oluştur / Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Listeye Dön / Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
