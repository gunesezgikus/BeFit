@model IEnumerable<BeFit.Models.ExerciseStats>

@{
    ViewData["Title"] = "İstatistikler / Stats";
}

<h1>İstatistikler <span class="text-muted fw-light">/ Statistics</span></h1>

<table class="table">
    <thead>
        <tr>
            <th>Egzersiz Adı <br /><small class="text-muted">Exercise Name</small></th>
            <th>Toplam Oturum <br /><small class="text-muted">Total Sessions</small></th>
            <th>Toplam Tekrar <br /><small class="text-muted">Total Reps</small></th>
            <th>Ortalama Ağırlık (kg) <br /><small class="text-muted">Average Load (kg)</small></th>
            <th>Maksimum Ağırlık (kg) <br /><small class="text-muted">Max Load (kg)</small></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.ExerciseName)</td>
            <td>@Html.DisplayFor(modelItem => item.TotalSessions)</td>
            <td>@Html.DisplayFor(modelItem => item.TotalReps)</td>
            <td>@Html.DisplayFor(modelItem => item.AvgLoad)</td>
            <td>@Html.DisplayFor(modelItem => item.MaxLoad)</td>
        </tr>
}
    </tbody>
</table>
